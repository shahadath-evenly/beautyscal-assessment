# Dependencies and build output are produced inside the image, never copied in.
node_modules/
dist/
dist-ssr/
build/

# Version control and Docker metadata
.git
.gitignore
.dockerignore
Dockerfile

# Caches
.vite/
*.tsbuildinfo
coverage/

# Secrets and local environment overrides. The API URL is passed as a build
# argument, so no .env file is needed in the build context.
.env
.env.local
.env.*.local
*.local

# Logs, documentation and editor noise
logs/
*.log
npm-debug.log*
*.md
.DS_Store
.idea/
.vscode/
