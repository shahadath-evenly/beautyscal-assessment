# Keep the build context to Go sources, module files and SQL.

# Version control and Docker metadata
.git
.gitignore
.dockerignore
Dockerfile

# Build output and local binaries
bin/
tmp/
out/
api
seed
*.exe
*.so
*.dylib

# Test, coverage and profiling artifacts
*.test
*.out
coverage.html
*.prof

# Vendored dependencies and developer-local workspace files
vendor/
go.work
go.work.sum

# Secrets and local environment overrides
.env
.env.local
.env.*.local

# Documentation and editor noise that cannot affect the build
*.md
.DS_Store
.idea/
.vscode/
