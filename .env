# Frontend environment. Copy to .env and adjust:
#   cp .env.example .env
# Never commit .env.
#
# Vite reads this file directly for `npm run dev` and `npm run build`, and
# Docker Compose reads it for the image build argument.

# Base URL of the backend API, as seen from the browser.
# VITE_API_BASE_URL=http://localhost:8081

VITE_API_BASE_URL=https://beauty-scale-backend-production.up.railway.app/

# Host port the Docker container publishes. The backend's
# CORS_ALLOWED_ORIGINS must match this origin.
FRONTEND_HOST_PORT=5173
