# Backend environment. Copy to .env and adjust:
#   cp .env.example .env
# Never commit .env or real credentials.

# --- PostgreSQL (the containerised database started by docker compose) ------
POSTGRES_USER=beautyscale
POSTGRES_PASSWORD=beautyscale
POSTGRES_DB=beautyscale
# Published on the host as 5433, because 5432 is used by a local PostgreSQL.
POSTGRES_HOST_PORT=5433

# --- API -------------------------------------------------------------------
BACKEND_HOST_PORT=8081
HTTP_PORT=8081
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=text
# Origin of the separately running frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# --- Database connection ---------------------------------------------------
# Used when running the API ON THE HOST (make api, make seed, go run ./cmd/api).
# `localhost:5433` is the containerised database published above. Point it at
# 5432 instead to use the PostgreSQL installed on your machine, e.g.
#   DATABASE_URL=postgres://shahadath@localhost:5432/bscale_dev?sslmode=disable
DATABASE_URL=postgres://beautyscale:beautyscale@localhost:5433/beautyscale?sslmode=disable

# Inside Docker this value is NOT used: the container reaches the database by
# the Compose service name `postgres`, derived from the POSTGRES_* values
# above. Uncomment to override the in-container connection string.
# DOCKER_DATABASE_URL=postgres://beautyscale:beautyscale@postgres:5432/beautyscale?sslmode=disable
