# Backend environment. Copy to .env and adjust:
#   cp .env.example .env
# Never commit .env or real credentials.

# --- PostgreSQL (the containerised database started by docker compose) ------
POSTGRES_USER=beautyscale
POSTGRES_PASSWORD=beautyscale
POSTGRES_DB=beautyscale
# Published on the host as 5433, because 5432 is used by a local PostgreSQL.
POSTGRES_HOST_PORT=5433

# --- API -------------------------------------------------------------------
BACKEND_HOST_PORT=8081
HTTP_PORT=8081
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
# Browser origins allowed to call the API. A single "*" allows any origin,
# which is convenient while testing from curl, Postman or another port.
# Tighten this to the frontend origin (http://localhost:5173) before deploying.
CORS_ALLOWED_ORIGINS=*
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# --- Database connection ---------------------------------------------------
# Used when running the API ON THE HOST (make api, make seed, go run ./cmd/api).
# `localhost:5433` is the containerised database published above. Point it at
# 5432 instead to use the PostgreSQL installed on your machine, e.g.
#   DATABASE_URL=postgres://shahadath@localhost:5432/bscale_dev?sslmode=disable
DATABASE_URL=postgres://beautyscale:beautyscale@localhost:5433/beautyscale?sslmode=disable

# Inside Docker this value is NOT used: the container reaches the database by
# the Compose service name `postgres`, derived from the POSTGRES_* values
# above. Uncomment to override the in-container connection string.
# DOCKER_DATABASE_URL=postgres://beautyscale:beautyscale@postgres:5432/beautyscale?sslmode=disable

# --- Buyer notification email ----------------------------------------------
# Accepting a request queues a message in the email_outbox table, inside the
# same transaction. A background worker sends it afterwards, so the HTTP
# response never waits for the provider.
#
# With no BREVO_API_KEY the worker logs each message instead of sending it,
# which the assessment accepts and which exercises the whole path without
# credentials. Set the key and a VERIFIED sender address to send for real.
# Placeholders only in this file: never commit a real key.
EMAIL_ENABLED=true
# BREVO_API_KEY=xkeysib-your-key-here
# BREVO_SENDER_EMAIL=sales@your-verified-domain.example
BREVO_SENDER_NAME=BeautyScale

# Worker tuning. The defaults are shown; all are optional.
# EMAIL_POLL_INTERVAL=10s
# EMAIL_BATCH_SIZE=10
# EMAIL_CONCURRENCY=2
# EMAIL_SEND_TIMEOUT=10s
# EMAIL_MAX_ATTEMPTS=5
# EMAIL_RETRY_BASE_DELAY=30s
# EMAIL_RETRY_MAX_DELAY=30m
# EMAIL_STALE_CLAIM_AFTER=5m
