# Shared placeholders for `docker compose up` at the repository root.
# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# backend/.env.example and frontend/.env.example document the full set of
# variables each app understands; this file holds only what Compose needs.

# ---------- PostgreSQL ----------
POSTGRES_USER=bscale
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=bscale_dev

# ---------- backend ----------
# Inside Compose the host is the service name, not localhost.
DATABASE_URL=postgres://bscale:change-me-locally@postgres:5432/bscale_dev?sslmode=disable
APP_ENV=docker
HTTP_PORT=8081
LOG_LEVEL=info
LOG_FORMAT=text
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email is optional. With no key the API logs the message instead of sending.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=BeautyScale

# ---------- frontend ----------
# Read by the browser, so it points at the published backend port.
VITE_API_BASE_URL=http://localhost:8081
# Filled in from the output of `make seed`.
VITE_WORKSPACES=[]
FRONTEND_HOST_PORT=5173
